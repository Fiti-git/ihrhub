# =========================
# IhrHub top-level docker-compose config
# Copy to .env and edit. Never commit .env.
# =========================

# --- Database (used by db + backend services) ---
DB_NAME=ihrhubnew
DB_USER=postgres
DB_PASSWORD=postgres

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# --- Frontend API URLs (must be reachable from your browser, so localhost:8000 in dev) ---
WEB_API_URL=http://localhost:8000
ADMIN_API_URL=http://localhost:8000
